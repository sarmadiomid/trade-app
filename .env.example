# Copy to .env and adjust. Used by docker compose / local runs.

# Required in production. Use a long random value (not this example).
AUTH_SECRET=change-me-to-a-long-random-string

# Shared MongoDB on the VPS `infra` network (hostname must resolve there).
# Example: mongodb://USER:PASS@mongo:27017/tradingchart?authSource=admin
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=tradingchart

# Optional: host bind for the app container (compose interpolation only)
# BIND=127.0.0.1:3000

# Optional: phones that may open /admin, separated by commas.
# Example: ADMIN_PHONES=09121234567,09129876543
# ADMIN_PHONES=


# Mediana OTP SMS (required for real SMS in production).
# API key from the Mediana panel; pattern code of an approved OTP pattern.
# https://developer.mediana.ir/?lang=en  POST /sms/v1/send/otp
# MEDIANA_API_KEY=
# MEDIANA_PATTERN_CODE=

# Zarinpal. The merchant id is the 36-character terminal code.
# Mode is sandbox (no real charge) or live. Outside production, sandbox is the default.
# Docs: https://www.zarinpal.com/docs/paymentGateway/connectToGateway.html
# ZARINPAL_MERCHANT_ID=
# ZARINPAL_MODE=sandbox

# SEP (Saman Electronic Payment). Terminal id from the SEP merchant panel.
# Register this server's public IP with SEP before live token requests.
# Docs: https://sep.shaparak.ir (OnlinePG token + VerifyTransaction)
# SEP_TERMINAL_ID=

# Public site origin for payment return URLs. Required in production (NODE_ENV=production).
# APP_URL=https://example.com

# Optional discount codes, as a JSON array. Synced into Mongo when checkout quotes a code.
# Usage counts are kept. Same code as src/server/discount-catalog.ts replaces that entry.
# DISCOUNT_CODES=[{"code":"WELCOME20","kind":"percent","value":20,"perUser":1,"label":"تخفیف خوش‌آمد"}]

# Dukascopy ingest worker (compose service `ingest`).
# Bootstrap last N years for all mapped TFs (1m…1M), then refresh every INGEST_INTERVAL_MS.
# INGEST_BOOTSTRAP_YEARS=3
# INGEST_INTERVAL_MS=43200000
# INGEST_OVERLAP_MS=172800000
# INGEST_TF_PAUSE_MS=1000
# DUKASCOPY_CACHE_PATH=.dukascopy-cache
#
# Outbound proxy for Dukascopy (Iran). Prefer DUKASCOPY_PROXY.
# From Docker to host sing-box: http://host.docker.internal:PORT  (or socks5://…)
# From host process / network_mode:host: http://127.0.0.1:PORT
# DUKASCOPY_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=
# HTTP_PROXY=
# NO_PROXY=localhost,127.0.0.1,mongo,mongodb
